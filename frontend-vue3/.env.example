# =============================================================================
# EduAI Frontend (Vue3 + TypeScript + Vite) - bien moi truong
#
# cp .env.example .env
#
# CANH BAO: moi bien co tien to VITE_ deu bi nhung vao bundle va NGUOI DUNG
# XEM DUOC. Tuyet doi khong dat API key / secret o day.
# =============================================================================

VITE_APP_NAME=EduAI
VITE_APP_ENV=development

# --- Ket noi backend ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000
# Endpoint SSE cho chat AI dang streaming
VITE_SSE_CHAT_PATH=/chat/stream

# --- OAuth Google (client id la thong tin cong khai, khong phai secret) -------
VITE_GOOGLE_CLIENT_ID=

# --- Upload tai lieu ---------------------------------------------------------
VITE_MAX_UPLOAD_SIZE_MB=100
VITE_ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,ppt,pptx,txt,md,mp4,jpg,jpeg,png

# --- Feature flags (bat dan theo lo trinh 12 tuan) ---------------------------
VITE_FEATURE_AI_CHAT=true
VITE_FEATURE_AI_QUIZ=true
VITE_FEATURE_AI_GRADING=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_NOTIFICATION=false
VITE_FEATURE_VIDEO_SUMMARY=false          # giai doan 2

# --- Observability -----------------------------------------------------------
VITE_SENTRY_DSN=
