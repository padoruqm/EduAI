# =============================================================================
# EduAI Backend (FastAPI) - bien moi truong
#
# cp .env.example .env  roi dien cac gia tri CHANGE_ME.
#
# LUU Y VE HOST:
#   Cac URL duoi day dung `localhost` -> danh cho truong hop chay uvicorn/celery
#   TRUC TIEP tren may (docker compose chi chay ha tang).
#   Khi dong goi backend vao container (Tuan 2), doi host thanh ten service:
#     localhost:5432  -> postgres:5432
#     localhost:6379  -> redis:6379
#     localhost:5672  -> rabbitmq:5672
#     localhost:9000  -> minio:9000
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=EduAI
APP_ENV=development                       # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Danh sach origin duoc phep goi API (frontend Vite chay o 5173)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
TIMEZONE=Asia/Ho_Chi_Minh

# --- Ket noi ha tang ---------------------------------------------------------
# Password phai khop voi file .env o thu muc goc
DATABASE_URL=postgresql+asyncpg://eduai:CHANGE_ME_postgres@localhost:5432/eduai
# Alembic dung driver dong bo
DATABASE_URL_SYNC=postgresql+psycopg://eduai:CHANGE_ME_postgres@localhost:5432/eduai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

REDIS_URL=redis://:CHANGE_ME_redis@localhost:6379/0

# RabbitMQ lam broker, Redis lam result backend
CELERY_BROKER_URL=amqp://eduai:CHANGE_ME_rabbitmq@localhost:5672//
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis@localhost:6379/1
CELERY_TASK_TIME_LIMIT=1800               # 30 phut, du cho embedding file lon
CELERY_WORKER_CONCURRENCY=2

# --- Auth (Module 1 - Tuan 2) ------------------------------------------------
# Sinh key moi: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15            # token ngan han
REFRESH_TOKEN_EXPIRE_DAYS=7               # refresh token luu Redis, co the thu hoi
PASSWORD_MIN_LENGTH=8

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Storage MinIO / S3 (Module 3) -------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=eduai
S3_SECRET_KEY=CHANGE_ME_minio
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_DOCUMENTS=eduai-documents
S3_BUCKET_SUBMISSIONS=eduai-submissions
S3_BUCKET_EXPORTS=eduai-exports
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,ppt,pptx,txt,md,mp4,jpg,jpeg,png
# Thoi han link tai file tu MinIO (giay)
PRESIGNED_URL_EXPIRE_SECONDS=3600

# --- AI / LLM (Module 4,5,6) -------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME_openai_key
OPENAI_CHAT_MODEL=gpt-4o-mini             # model mac dinh cho chat/RAG
OPENAI_CHAT_MODEL_HEAVY=gpt-4o            # dung cho sinh de + cham bai (can chinh xac hon)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                        # PHAI khop voi kieu cot vector(1536) trong DB
OPENAI_REQUEST_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# --- RAG (Module 3,4 - Tuan 4-6) ---------------------------------------------
CHUNK_SIZE=500                            # token moi chunk
CHUNK_OVERLAP=75                          # ~15% overlap
RAG_TOP_K=5                               # so doan ngu canh dua vao prompt
RAG_MIN_SCORE=0.25                        # duoi nguong nay coi nhu khong tim thay ngu canh
EMBEDDING_BATCH_SIZE=64
# Cache cau hoi trung lap - giai bai toan "200 cau hoi giong nhau"
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=86400
RAG_CACHE_SIMILARITY_THRESHOLD=0.92       # >= nguong nay thi tra lai cau tra loi cu, khong goi LLM
CHAT_STREAMING_ENABLED=true               # tra loi dang SSE

# --- Kiem soat chi phi LLM (rui ro so 1 trong tai lieu) ----------------------
LLM_MAX_TOKENS_PER_REQUEST=4096
LLM_MAX_CONCURRENCY=5                     # gioi han goi song song khi cham 500 bai
LLM_MONTHLY_BUDGET_USD=50                 # vuot nguong thi chan va canh bao
LLM_COST_TRACKING_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER_PER_MINUTE=20
RATE_LIMIT_AI_PER_USER_PER_DAY=100

# --- AI Grading (Module 6 - Tuan 8) ------------------------------------------
# Diem AI cham luon o trang thai "de xuat", giao vien duyet truoc khi cong bo
GRADING_REQUIRE_TEACHER_APPROVAL=true
GRADING_BATCH_SIZE=20
# OCR bai viet tay: PoC tuan 6, mac dinh TAT o giai doan 1
OCR_ENABLED=false
OCR_PROVIDER=                             # tesseract | google_vision
GOOGLE_VISION_CREDENTIALS_PATH=

# --- Notification (Module 10 - Tuan 10) --------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@eduai.local
SMTP_FROM_NAME=EduAI
SMTP_USE_TLS=true
# So gio truoc deadline thi gui nhac nho
NOTIFY_DEADLINE_HOURS_BEFORE=24
# Firebase Push - giai doan 2, de trong o giai doan 1
FIREBASE_CREDENTIALS_PATH=

# --- Analytics (Module 9 - Tuan 9) -------------------------------------------
# Dashboard tinh theo batch moi dem thay vi real-time moi lan load trang
ANALYTICS_BATCH_CRON=0 2 * * *
ANALYTICS_WEAK_STUDENT_THRESHOLD=5.0      # diem trung binh duoi nguong = hoc sinh yeu

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                           # json | console
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
