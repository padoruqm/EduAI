# =============================================================================
# EduAI - bien moi truong cho docker-compose (tang ha tang)
#
# Cach dung:  cp .env.example .env   roi doi cac gia tri CHANGE_ME
# File .env KHONG duoc commit (da co trong .gitignore).
#
# Bien cua ung dung nam o file rieng:
#   backend-fastapi/.env.example
#   frontend-vue3/.env.example
# =============================================================================

COMPOSE_PROJECT_NAME=eduai

# --- PostgreSQL + pgvector ---------------------------------------------------
POSTGRES_USER=eduai
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=eduai
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_DEFAULT_USER=eduai
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO (S3-compatible storage) -------------------------------------------
# MINIO_ROOT_PASSWORD phai dai toi thieu 8 ky tu, neu khong MinIO se khong khoi dong.
MINIO_ROOT_USER=eduai
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_BUCKET_DOCUMENTS=eduai-documents      # tai lieu giao vien upload (PDF/Word/Slide/Video)
S3_BUCKET_SUBMISSIONS=eduai-submissions  # bai hoc sinh nop
S3_BUCKET_EXPORTS=eduai-exports          # de thi / bao cao export PDF

# --- Cong cho cac service se bat tu Tuan 2 -----------------------------------
API_PORT=8000
FRONTEND_PORT=5173
NGINX_HTTP_PORT=80
